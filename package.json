    "replay-trace": "node src/commands/replay-trace.ts",
    "check-races": "node src/commands/check-races.ts",
    "measure-races": "node src/commands/measure-races.ts",
    "eval-model": "node --env-file=.env src/commands/eval-model.ts",
    "eval-report": "node src/commands/eval-report.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"

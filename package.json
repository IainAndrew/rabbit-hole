{
  "name": "rabbit-hole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc && tsc -p site",
    "test": "node --test",
    "race-by-hand": "node src/commands/race-by-hand.ts",
    "list-models": "node src/commands/list-models.ts",
    "model-endpoints": "node src/commands/model-endpoints.ts",
    "race-agent": "node --env-file=.env src/commands/race-agent.ts",
    "replay-trace": "node src/commands/replay-trace.ts",
    "check-races": "node src/commands/check-races.ts",
    "measure-races": "node src/commands/measure-races.ts",
    "race-distance": "node src/commands/race-distance.ts",
    "eval-model": "node --env-file=.env src/commands/eval-model.ts",
    "eval-report": "node src/commands/eval-report.ts",
    "compare-evals": "node src/commands/compare-evals.ts",
    "build-site": "node src/commands/build-site.ts && vite build site",
    "serve-site": "vite site"
  },
  "devDependencies": {
    "@observablehq/plot": "0.6.17",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "17.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
